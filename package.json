{
  "name": "trex-token-suite",
  "version": "4.0.0",
  "description": "T-REX: ERC-3643 Token and Compliance Suite - A comprehensive full-stack solution for deploying and managing security tokens",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd trex-scaffold/packages/react-app && npm start",
    "start:dev": "concurrently \"npm run start:blockchain\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:blockchain": "npx hardhat node",
    "install:all": "npm install && cd backend && npm install && cd ../trex-scaffold/packages/react-app && npm install",
    "build": "cd trex-scaffold/packages/react-app && npm run build",
    "test": "npx hardhat test",
    "test:coverage": "npx hardhat coverage",
    "test:compliance": "npx hardhat test test/compliance.test.ts",
    "test:token": "npx hardhat test test/token/",
    "test:registries": "npx hardhat test test/registries/",
    "deploy:factory": "npx hardhat run scripts/deploy_factory_enhanced.js",
    "deploy:token": "npx hardhat run scripts/deploy_token_enhanced.js",
    "deploy:compliance": "npx hardhat run scripts/deploy_modular_compliance.js",
    "deploy:registry": "npx hardhat run scripts/deploy_identity_registry.js",
    "deploy:storage": "npx hardhat run scripts/deploy_identity_registry_storage.js",
    "deploy:claim-topics": "npx hardhat run scripts/deploy_claim_topics_registry.js",
    "deploy:trusted-issuers": "npx hardhat run scripts/deploy_trusted_issuers_registry.js",
    "clean": "node scripts/clean-addresses.js",
    "flatten": "node scripts/flatten.js",
    "compile": "npx hardhat compile",
    "lint": "npx hardhat lint",
    "lint:fix": "npx hardhat lint --fix",
    "typechain": "npx hardhat typechain",
    "verify": "npx hardhat verify",
    "node": "npx hardhat node",
    "console": "npx hardhat console",
    "accounts": "npx hardhat accounts",
    "balance": "npx hardhat balance",
    "send": "npx hardhat send",
    "generate:doc": "npx hardhat docgen",
    "size-contracts": "npx hardhat size-contracts",
    "gas-report": "REPORT_GAS=true npx hardhat test",
    "coverage": "npx hardhat coverage",
    "coverage:report": "npx hardhat coverage && open coverage/index.html"
  },
  "keywords": [
    "ethereum",
    "erc-3643",
    "security-token",
    "compliance",
    "defi",
    "blockchain",
    "solidity",
    "react",
    "typescript",
    "hardhat"
  ],
  "author": "T-REX Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.8",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.4",
    "@nomicfoundation/hardhat-verify": "^2.0.1",
    "@typechain/ethers-v6": "^0.4.3",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.5",
    "@types/mocha": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "chai": "^4.3.10",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "ethers": "^6.8.1",
    "hardhat": "^2.19.1",
    "hardhat-gas-reporter": "^1.0.9",
    "prettier": "^3.1.0",
    "prettier-plugin-solidity": "^1.3.1",
    "solidity-coverage": "^0.8.5",
    "typechain": "^8.3.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@onchain-id/solidity": "^3.5.2",
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tokeny/T-REX.git"
  },
  "bugs": {
    "url": "https://github.com/tokeny/T-REX/issues"
  },
  "homepage": "https://github.com/tokeny/T-REX#readme"
}
